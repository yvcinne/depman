#!/usr/bin/env bash
# =============================================================================
# depman — Gestionnaire de dépendances Bash
# ESET Mohammedia 2025-2026
# =============================================================================

set -euo pipefail

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------
LOG_DIR="/var/log/depman"
LOG_FILE="$LOG_DIR/history.log"
SNAPSHOT_DIR="$LOG_DIR/snapshots"
THREAD_BIN="$(dirname "$(realpath "$0")")/depman_thread"
THREAD_SRC="$(dirname "$(realpath "$0")")/depman_thread.c"
PM=""   # Détecté au démarrage par detect_pm()
DRY_RUN=0  # Mode simulation (--dry-run)

# ---------------------------------------------------------------------------
# Couleurs (désactivées si le terminal ne les supporte pas)
# ---------------------------------------------------------------------------
if [[ -t 1 ]] && tput colors &>/dev/null 2>&1 && (( $(tput colors 2>/dev/null) >= 8 )); then
    C_GRN="\033[0;32m"   # Vert  — succès
    C_YEL="\033[0;33m"   # Jaune — dry-run
    C_RED="\033[0;31m"   # Rouge — erreur
    C_CYN="\033[0;36m"   # Cyan  — progression
    C_BLD="\033[1m"      # Gras
    C_RST="\033[0m"      # Reset
else
    C_GRN="" C_YEL="" C_RED="" C_CYN="" C_BLD="" C_RST=""
fi

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
log() {
    local type="$1"   # INFOS ou ERROR
    local msg="$2"
    local ts
    ts=$(date "+%Y-%m-%d-%H-%M-%S")
    local user
    user=$(whoami)
    local entry="$ts:$user:$type:$msg"
    mkdir -p "$LOG_DIR" 2>/dev/null || true
    # Écriture brute dans le fichier (sans codes couleur)
    echo "$entry" >> "$LOG_FILE"
    # Affichage coloré dans le terminal
    case "$type" in
        INFOS) printf "${C_GRN}%s${C_RST}\n" "$entry" ;;
        ERROR) printf "${C_RED}%s${C_RST}\n" "$entry" >&2 ;;
        *)     printf "%s\n" "$entry" ;;
    esac
}

log_info()  { log "INFOS" "$1"; }
log_error() { log "ERROR" "$1" >&2; }

# ---------------------------------------------------------------------------
# Progression [X/N]
# ---------------------------------------------------------------------------
PROG_CURRENT=0
PROG_TOTAL=0

show_progress() {
    local pkg="$1"
    PROG_CURRENT=$(( PROG_CURRENT + 1 ))
    (( PROG_TOTAL > 0 )) || return 0
    printf "${C_CYN}[%d/%d]${C_RST} ${C_BLD}Vérification de %s...${C_RST}\n" \
        "$PROG_CURRENT" "$PROG_TOTAL" "$pkg"
}

# ---------------------------------------------------------------------------
# Détection du gestionnaire de paquets
# ---------------------------------------------------------------------------
detect_pm() {
    if   command -v apt-get &>/dev/null; then echo "apt"
    elif command -v pacman  &>/dev/null; then echo "pacman"
    elif command -v dnf     &>/dev/null; then echo "dnf"
    elif command -v yum     &>/dev/null; then echo "yum"
    elif command -v zypper  &>/dev/null; then echo "zypper"
    elif command -v apk     &>/dev/null; then echo "apk"
    else echo "unknown"
    fi
}

# ---------------------------------------------------------------------------
# Gestion des erreurs
# ---------------------------------------------------------------------------
handle_error() {
    local code="$1"
    local msg="$2"
    log_error "[Erreur $code] $msg"
    log_error "Utilisez 'depman -h' pour afficher l'aide."
    exit "$code"
}

# ---------------------------------------------------------------------------
# Aide
# ---------------------------------------------------------------------------
show_help() {
    cat <<'EOF'

USAGE
  depman [OPTIONS] <projet>

OPTIONS
  -s <projet>             Mode subshell  — vérification séquentielle dans un sous-shell
  -f <projet>             Mode fork      — vérification parallèle par processus fils
  -t <projet>             Mode thread    — vérification parallèle via depman_thread (C+pthreads)
  -l <répertoire>         Répertoire de stockage du fichier de journalisation (défaut: /var/log/depman/)
                          Le fichier history.log sera créé dans ce répertoire.
  -r <projet> [horodatage]  Restauration — restaure depuis le dernier snapshot (root requis)
                          Si [horodatage] est fourni, restaure ce snapshot précis.
                          Format horodatage : YYYYMMDDHHMMSS (ex: 20260504120000)
                          Utilisez 'ls /var/log/depman/snapshots/' pour lister les snapshots.
  -n / --dry-run          Mode simulation — affiche ce qui serait installé sans rien modifier
  -h                      Affiche cette aide

CODES D'ERREUR
  100  Option inexistante
  101  Paramètre <projet> manquant
  102  Fichier deps.conf introuvable
  103  Paquet introuvable dans les dépôts apt
  104  Privilèges root requis
  105  Snapshot introuvable
  106  Compilation de depman_thread.c échouée

EXEMPLES
  depman -s projet-light
  depman -f projet-medium
  depman -t projet-heavy
  depman -n -s projet-light                     # simulation (aucune installation)
  sudo depman -r projet-medium                  # dernier snapshot
  sudo depman -r projet-medium 20260504120000   # snapshot spécifique

FORMAT deps.conf
  # commentaire
  [project:monapp]
  git >= 2.30
  curl >= 7.0
  nodejs >= 16.0

EOF
}

# ---------------------------------------------------------------------------
# Comparaison de versions (Bash pur)
# Retourne 0 si $1 >= $2, 1 sinon
# ---------------------------------------------------------------------------
version_ge() {
    local installed="$1"
    local required="$2"

    # Normalise en tableaux de nombres
    IFS='.' read -ra inst_parts <<< "$installed"
    IFS='.' read -ra req_parts  <<< "$required"

    local max_len="${#inst_parts[@]}"
    (( ${#req_parts[@]} > max_len )) && max_len="${#req_parts[@]}"

    for (( i=0; i<max_len; i++ )); do
        local a="${inst_parts[$i]:-0}"
        local b="${req_parts[$i]:-0}"
        # Garde uniquement la partie numérique (ex: "2.43.0-ubuntu")
        a="${a//[^0-9]/}"
        b="${b//[^0-9]/}"
        a="${a:-0}"; b="${b:-0}"
        if (( 10#$a > 10#$b )); then return 0; fi
        if (( 10#$a < 10#$b )); then return 1; fi
    done
    return 0   # égaux → OK
}

# ---------------------------------------------------------------------------
# Vérification et installation d'un paquet (distro-agnostique)
# ---------------------------------------------------------------------------
check_dep() {
    local pkg="$1"
    local req_ver="$2"
    local inst_ver=""
    local installed=false

    show_progress "$pkg"

    case "$PM" in
        apt)
            if dpkg -l "$pkg" 2>/dev/null | grep -q '^ii'; then
                installed=true
                inst_ver=$(dpkg -l "$pkg" 2>/dev/null | awk '/^ii/{print $3}' | head -1)
                inst_ver="${inst_ver##*:}"; inst_ver="${inst_ver%%-*}"
            fi
            ;;
        pacman)
            if pacman -Q "$pkg" &>/dev/null; then
                installed=true
                inst_ver=$(pacman -Q "$pkg" 2>/dev/null | awk '{print $2}')
                inst_ver="${inst_ver%%-*}"
            fi
            ;;
        dnf|yum)
            if rpm -q "$pkg" &>/dev/null; then
                installed=true
                inst_ver=$(rpm -q --qf '%{VERSION}' "$pkg" 2>/dev/null)
            fi
            ;;
        zypper)
            if rpm -q "$pkg" &>/dev/null; then
                installed=true
                inst_ver=$(rpm -q --qf '%{VERSION}' "$pkg" 2>/dev/null)
            fi
            ;;
        apk)
            if apk info -e "$pkg" &>/dev/null; then
                installed=true
                inst_ver=$(apk info "$pkg" 2>/dev/null | head -1 | grep -oE '[0-9]+\.[0-9]+[.0-9]*')
            fi
            ;;
        *)
            log_error "Gestionnaire de paquets non supporté : $PM"
            return 1
            ;;
    esac

    if $installed; then
        if version_ge "$inst_ver" "$req_ver"; then
            log_info "Vérification de $pkg >= $req_ver -> OK (v$inst_ver)"
        else
            log_info "$pkg installé (v$inst_ver) mais version insuffisante (>= $req_ver requis). Mise à jour..."
            install_dep "$pkg"
        fi
    else
        log_info "$pkg absent, installation en cours..."
        install_dep "$pkg"
    fi
}

install_dep() {
    local pkg="$1"
    local new_ver=""

    # Mode simulation : afficher sans installer
    if (( DRY_RUN )); then
        printf "${C_YEL}[DRY-RUN]${C_RST} %-20s serait installé ou mis à jour\n" "$pkg"
        log_info "[DRY-RUN] $pkg serait installé ou mis à jour"
        return 0
    fi

    case "$PM" in
        apt)
            if ! apt-cache show "$pkg" &>/dev/null; then
                log_error "$pkg introuvable dans les dépôts apt [code 103]"
                return 103
            fi
            apt-get install -y "$pkg" &>/dev/null \
                || { log_error "$pkg : échec de l'installation [code 103]"; return 103; }
            new_ver=$(dpkg -l "$pkg" 2>/dev/null | awk '/^ii/{print $3}' | head -1)
            new_ver="${new_ver##*:}"; new_ver="${new_ver%%-*}"
            ;;
        pacman)
            if ! pacman -Si "$pkg" &>/dev/null; then
                log_error "$pkg introuvable dans les dépôts pacman [code 103]"
                return 103
            fi
            pacman -S --noconfirm "$pkg" &>/dev/null \
                || { log_error "$pkg : échec de l'installation [code 103]"; return 103; }
            new_ver=$(pacman -Q "$pkg" 2>/dev/null | awk '{print $2}')
            new_ver="${new_ver%%-*}"
            ;;
        dnf)
            if ! dnf info "$pkg" &>/dev/null; then
                log_error "$pkg introuvable dans les dépôts dnf [code 103]"
                return 103
            fi
            dnf install -y "$pkg" &>/dev/null \
                || { log_error "$pkg : échec de l'installation [code 103]"; return 103; }
            new_ver=$(rpm -q --qf '%{VERSION}' "$pkg" 2>/dev/null)
            ;;
        yum)
            if ! yum info "$pkg" &>/dev/null; then
                log_error "$pkg introuvable dans les dépôts yum [code 103]"
                return 103
            fi
            yum install -y "$pkg" &>/dev/null \
                || { log_error "$pkg : échec de l'installation [code 103]"; return 103; }
            new_ver=$(rpm -q --qf '%{VERSION}' "$pkg" 2>/dev/null)
            ;;
        zypper)
            if ! zypper info "$pkg" &>/dev/null; then
                log_error "$pkg introuvable dans les dépôts zypper [code 103]"
                return 103
            fi
            zypper install -y "$pkg" &>/dev/null \
                || { log_error "$pkg : échec de l'installation [code 103]"; return 103; }
            new_ver=$(rpm -q --qf '%{VERSION}' "$pkg" 2>/dev/null)
            ;;
        apk)
            if ! apk search -e "$pkg" &>/dev/null; then
                log_error "$pkg introuvable dans les dépôts apk [code 103]"
                return 103
            fi
            apk add "$pkg" &>/dev/null \
                || { log_error "$pkg : échec de l'installation [code 103]"; return 103; }
            new_ver=$(apk info "$pkg" 2>/dev/null | head -1 | grep -oE '[0-9]+\.[0-9]+[.0-9]*')
            ;;
        *)
            log_error "Gestionnaire de paquets non supporté : $PM [code 103]"
            return 103
            ;;
    esac

    log_info "$pkg installé avec succès (v${new_ver:-?})"
}

# ---------------------------------------------------------------------------
# Parsing de deps.conf
# ---------------------------------------------------------------------------
parse_conf() {
    local project="$1"
    local conf_file="$project/deps.conf"

    # Erreur 102 si fichier absent
    [[ ! -f "$conf_file" ]] && handle_error 102 "deps.conf introuvable dans '$project'"

    # Lire les dépendances (ignorer commentaires, sections, lignes vides)
    while IFS= read -r line; do
        # Ignorer commentaires et sections
        [[ "$line" =~ ^[[:space:]]*# ]] && continue
        [[ "$line" =~ ^[[:space:]]*\[ ]] && continue
        [[ -z "${line// }" ]] && continue

        # Parser : paquet >= version
        if [[ "$line" =~ ^([a-zA-Z0-9_+.-]+)[[:space:]]*\>=[[:space:]]*([0-9][0-9.]*)$ ]]; then
            local pkg="${BASH_REMATCH[1]}"
            local ver="${BASH_REMATCH[2]}"
            echo "$pkg $ver"
        fi
    done < "$conf_file"
}

# ---------------------------------------------------------------------------
# Snapshot (distro-agnostique)
# ---------------------------------------------------------------------------
snapshot() {
    local project="$1"
    mkdir -p "$SNAPSHOT_DIR"
    local snap_file="$SNAPSHOT_DIR/${project//\//_}_$(date +%Y%m%d%H%M%S).snap"

    case "$PM" in
        apt)    dpkg --get-selections > "$snap_file" ;;
        pacman) pacman -Qqe            > "$snap_file" ;;
        dnf|yum|zypper) rpm -qa --qf '%{NAME}\n' > "$snap_file" ;;
        apk)    apk info               > "$snap_file" ;;
        *)
            log_error "Snapshot non supporté pour le gestionnaire : $PM"
            return 1
            ;;
    esac

    log_info "Snapshot sauvegardé : $snap_file"
    echo "$snap_file"
}

restore_snapshot() {
    local project="$1"
    local snap_ts="${2:-}"   # horodatage optionnel (ex: 20260504120000)
    local pattern="$SNAPSHOT_DIR/${project//\//_}_*.snap"
    local snap_file

    if [[ -n "$snap_ts" ]]; then
        # Snapshot spécifique demandé
        snap_file="$SNAPSHOT_DIR/${project//\//_}_${snap_ts}.snap"
        if [[ ! -f "$snap_file" ]]; then
            log_error "Snapshot '$snap_ts' introuvable pour '$project'."
            log_error "Snapshots disponibles :"
            # shellcheck disable=SC2086
            ls -1t $pattern 2>/dev/null \
                | sed "s|$SNAPSHOT_DIR/||" \
                | sed "s|${project//\//_}_||;s|\.snap||" \
                || log_error "  (aucun snapshot trouvé)"
            handle_error 105 "Snapshot introuvable : $snap_ts"
        fi
    else
        # Dernier snapshot (comportement par défaut)
        # shellcheck disable=SC2086
        snap_file=$(ls -t $pattern 2>/dev/null | head -1)
        [[ -z "$snap_file" ]] && handle_error 105 "Aucun snapshot trouvé pour '$project'"
    fi

    log_info "Restauration depuis $snap_file ..."
    case "$PM" in
        apt)
            dpkg --set-selections < "$snap_file"
            apt-get dselect-upgrade -y
            ;;
        pacman)
            # shellcheck disable=SC2046
            pacman -S --noconfirm $(cat "$snap_file") &>/dev/null
            ;;
        dnf|yum|zypper|apk)
            log_error "Restauration automatique non supportée pour $PM — snapshot conservé à titre informatif."
            ;;
        *)
            handle_error 105 "Restauration non supportée pour : $PM"
            ;;
    esac
    log_info "Restauration terminée."
}

# ---------------------------------------------------------------------------
# Compilation du programme C
# ---------------------------------------------------------------------------
compile_thread_prog() {
    # Ne recompiler que si binaire absent ou source plus récente
    if [[ -f "$THREAD_BIN" && "$THREAD_BIN" -nt "$THREAD_SRC" ]]; then
        return 0
    fi
    [[ ! -f "$THREAD_SRC" ]] && handle_error 106 "depman_thread.c introuvable"
    gcc -o "$THREAD_BIN" "$THREAD_SRC" -lpthread \
        || handle_error 106 "Compilation de depman_thread.c échouée"
    log_info "Programme thread compilé avec succès"
}

# ---------------------------------------------------------------------------
# Mode SUBSHELL (-s)  — séquentiel dans un sous-shell (isolation variables)
# ---------------------------------------------------------------------------
run_subshell() {
    local project="$1"
    log_info "=== Mode subshell pour '$project' ==="
    local dep_list
    dep_list=$(parse_conf "$project")
    PROG_TOTAL=$(echo "$dep_list" | grep -c .)
    PROG_CURRENT=0
    (
        while IFS=' ' read -r pkg ver; do
            check_dep "$pkg" "$ver"
        done <<< "$dep_list"
    )
    local code=$?
    (( DRY_RUN )) || snapshot "$project"
    return $code
}

# ---------------------------------------------------------------------------
# Mode FORK (-f)  — un processus fils par paquet
# ---------------------------------------------------------------------------
run_fork() {
    local project="$1"
    log_info "=== Mode fork pour '$project' ==="
    local dep_list
    dep_list=$(parse_conf "$project")
    PROG_TOTAL=$(echo "$dep_list" | grep -c .)
    PROG_CURRENT=0

    local pids=()
    while IFS=' ' read -r pkg ver; do
        PROG_CURRENT=$(( PROG_CURRENT + 1 ))
        printf "${C_CYN}[%d/%d]${C_RST} ${C_BLD}Fork lancé pour %s...${C_RST}\n" \
            "$PROG_CURRENT" "$PROG_TOTAL" "$pkg"
        (
            PROG_TOTAL=0   # désactive show_progress dans le fils
            check_dep "$pkg" "$ver"
        ) &
        pids+=($!)
        log_info "Processus fils lancé pour $pkg (PID $!)"
    done <<< "$dep_list"

    # Attendre tous les fils
    local exit_code=0
    for pid in "${pids[@]}"; do
        wait "$pid" || exit_code=$?
    done

    (( DRY_RUN )) || snapshot "$project"
    return $exit_code
}

# ---------------------------------------------------------------------------
# Mode THREAD (-t)  — dépendances vérifiées via depman_thread (C+pthreads)
# ---------------------------------------------------------------------------
run_thread() {
    local project="$1"
    log_info "=== Mode thread pour '$project' ==="

    compile_thread_prog

    # Collecter la liste des paquets
    local pkgs=()
    local vers=()
    while IFS=' ' read -r pkg ver; do
        pkgs+=("$pkg")
        vers+=("$ver")
    done < <(parse_conf "$project")

    [[ ${#pkgs[@]} -eq 0 ]] && handle_error 102 "Aucune dépendance dans deps.conf"

    PROG_TOTAL=${#pkgs[@]}
    PROG_CURRENT=0
    log_info "Lancement de $PROG_TOTAL threads en parallèle..."

    # Appel du programme C (vérifie la présence du paquet en parallèle)
    local results
    results=$( { time "$THREAD_BIN" "${pkgs[@]}"; } 2>&1 | grep -v '^real\|^user\|^sys')

    # Traiter les résultats (format: nom_paquet:1 ou nom_paquet:0)
    while IFS=: read -r pkg status; do
        PROG_CURRENT=$(( PROG_CURRENT + 1 ))
        printf "${C_CYN}[%d/%d]${C_RST} ${C_BLD}Résultat pour %s${C_RST}\n" \
            "$PROG_CURRENT" "$PROG_TOTAL" "$pkg"
        if [[ "$status" -eq 1 ]]; then
            log_info "$pkg : présent"
        else
            log_info "$pkg : absent — installation en cours..."
            install_dep "$pkg"
        fi
    done <<< "$results"

    (( DRY_RUN )) || snapshot "$project"
}

# ---------------------------------------------------------------------------
# Mode RESTAURATION (-r)  — root requis
# ---------------------------------------------------------------------------
run_restore() {
    local project="$1"
    local snap_ts="${2:-}"
    [[ $EUID -ne 0 ]] && handle_error 104 "L'option -r nécessite les privilèges root"
    restore_snapshot "$project" "$snap_ts"
}

# ---------------------------------------------------------------------------
# Point d'entrée principal
# ---------------------------------------------------------------------------
main() {
    [[ $# -eq 0 ]] && { log_error "[Erreur 101] Aucune option fournie. Utilisez 'depman -h' pour afficher l'aide."; exit 101; }

    local opt_s=0 opt_f=0 opt_t=0 opt_r=0 opt_l=0
    local project="" alt_log="" snap_ts=""

    # Parsing des options avec getopt
    local OPTS
    OPTS=$(getopt -o s:f:t:l:r:nh --long help,dry-run -n "depman" -- "$@") \
        || handle_error 100 "Option non reconnue"
    eval set -- "$OPTS"

    while true; do
        case "$1" in
            -s) opt_s=1; project="$2"; shift 2 ;;
            -f) opt_f=1; project="$2"; shift 2 ;;
            -t) opt_t=1; project="$2"; shift 2 ;;
            -r) opt_r=1; project="$2"; shift 2 ;;
            -l) opt_l=1; alt_log="$2"; LOG_FILE="${alt_log%/}/history.log"; shift 2 ;;
            -n|--dry-run) DRY_RUN=1; shift ;;
            -h|--help) show_help; exit 0 ;;
            --) shift; break ;;
            *) handle_error 100 "Option non reconnue : $1" ;;
        esac
    done

    # Argument positionnel optionnel : horodatage snapshot pour -r
    snap_ts="${1:-}"

    # Vérifier qu'un projet est fourni si une action est demandée
    if (( opt_s || opt_f || opt_t || opt_r )); then
        [[ -z "$project" ]] && handle_error 101 "Paramètre <projet> manquant"
    else
        handle_error 101 "Aucune option d'action fournie"
    fi

    # Créer le répertoire de log
    mkdir -p "$LOG_DIR" 2>/dev/null || true

    # Avertissement dry-run
    if (( DRY_RUN )); then
        printf "${C_YEL}★ MODE DRY-RUN activé — aucune modification ne sera effectuée${C_RST}\n"
    fi

    # Détecter le gestionnaire de paquets
    PM=$(detect_pm)
    log_info "Gestionnaire de paquets détecté : $PM"
    [[ "$PM" == "unknown" ]] && handle_error 100 "Aucun gestionnaire de paquets supporté trouvé (apt/pacman/dnf/yum/zypper/apk)"

    # Dispatcher
    if   (( opt_r )); then run_restore "$project" "$snap_ts"
    elif (( opt_s )); then run_subshell "$project"
    elif (( opt_f )); then run_fork    "$project"
    elif (( opt_t )); then run_thread  "$project"
    fi
}

main "$@"
