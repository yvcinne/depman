#!/usr/bin/env bash


# =============================================================================
# depman — Gestionnaire de dépendances Bash
# =============================================================================

set -euo pipefail

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------
LOG_DIR="/var/log/depman"
LOG_FILE="$LOG_DIR/history.log"
SNAPSHOT_DIR="$LOG_DIR/snapshots"
THREAD_BIN="$(dirname "$(realpath "$0")")/depman_thread"
THREAD_SRC="$(dirname "$(realpath "$0")")/depman_thread.c"
PM=""       # Détecté au démarrage par detect_pm()
DRY_RUN=0   # 1 = simulation, aucune modification du système

# ---------------------------------------------------------------------------
# Colors  (disabled automatically when stdout is not a terminal)
# ---------------------------------------------------------------------------
if [[ -t 1 ]]; then
    C_RESET=$'\e[0m'
    C_BOLD=$'\e[1m'
    C_DIM=$'\e[2m'
    C_GREEN=$'\e[32m'
    C_YELLOW=$'\e[33m'
    C_RED=$'\e[31m'
    C_CYAN=$'\e[36m'
    C_MAGENTA=$'\e[35m'
    C_BLUE=$'\e[34m'
else
    C_RESET='' C_BOLD='' C_DIM='' C_GREEN='' C_YELLOW=''
    C_RED=''   C_CYAN='' C_MAGENTA='' C_BLUE=''
fi

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
log() {
    local type="$1"   # INFOS ou ERROR
    local msg="$2"
    local ts
    ts=$(date "+%Y-%m-%d-%H-%M-%S")
    local user
    user=$(whoami)
    local entry="$ts:$user:$type:$msg"
    # Créer le répertoire log si nécessaire (best effort)
    mkdir -p "$LOG_DIR" 2>/dev/null || true
    # Append raw entry to file (no color)
    echo "$entry" >> "$LOG_FILE" 2>/dev/null || true
    # Print colored entry to terminal
    case "$type" in
        INFOS) echo "${C_DIM}${ts}${C_RESET} ${C_CYAN}[INFO]${C_RESET}  $msg" ;;
        ERROR) echo "${C_DIM}${ts}${C_RESET} ${C_RED}${C_BOLD}[ERROR]${C_RESET} $msg" >&2 ;;
        *)     echo "${C_DIM}${ts}${C_RESET} [${type}] $msg" ;;
    esac
}

log_info()  { log "INFOS" "$1"; }
log_error() { log "ERROR" "$1"; }

# ---------------------------------------------------------------------------
# Détection du gestionnaire de paquets
# ---------------------------------------------------------------------------
detect_pm() {
    if   command -v apt-get &>/dev/null; then echo "apt"
    elif command -v pacman  &>/dev/null; then echo "pacman"
    elif command -v dnf     &>/dev/null; then echo "dnf"
    elif command -v yum     &>/dev/null; then echo "yum"
    elif command -v zypper  &>/dev/null; then echo "zypper"
    elif command -v apk     &>/dev/null; then echo "apk"
    else echo "unknown"
    fi
}

# ---------------------------------------------------------------------------
# Gestion des erreurs
# ---------------------------------------------------------------------------
handle_error() {
    local code="$1"
    local msg="$2"
    log_error "[Erreur $code] $msg"
    log_error "Utilisez 'depman -h' pour afficher l'aide."
    exit "$code"
}

# ---------------------------------------------------------------------------
# Aide
# ---------------------------------------------------------------------------
show_help() {
    cat <<'EOF'

USAGE
  depman [OPTIONS] <projet>

OPTIONS
  -s <projet>             Mode subshell  — vérification séquentielle dans un sous-shell
  -f <projet>             Mode fork      — vérification parallèle par processus fils
  -t <projet>             Mode thread    — vérification parallèle via depman_thread (C+pthreads)
  -l <répertoire>         Répertoire de stockage du fichier de journalisation (défaut: /var/log/depman/)
                          Le fichier history.log et le dossier snapshots/ seront créés dans ce répertoire.
  -r <projet> [horodatage]  Restauration — restaure depuis le dernier snapshot (root requis)
                          Si [horodatage] est fourni, restaure ce snapshot précis.
                          Format horodatage : YYYYMMDDHHMMSS (ex: 20260504120000)
                          Utilisez 'ls /var/log/depman/snapshots/' pour lister les snapshots.
  -d, --diff <projet> <ts1> <ts2>
                          Compare deux snapshots et affiche les paquets ajoutés/supprimés.
                          Format horodatage : YYYYMMDDHHMMSS
                          Exemple: depman --diff python-test 20260511171214 20260511164240
  -n, --dry-run           Mode simulation — affiche ce qui serait installé sans rien modifier
  -v, --version           Affiche la version de depman
  -h                      Affiche cette aide

CODES D'ERREUR
  100  Option inexistante
  101  Paramètre <projet> manquant
  102  Fichier deps.conf introuvable
  103  Paquet introuvable dans les dépôts apt
  104  Privilèges root requis
  105  Snapshot introuvable
  106  Compilation de depman_thread.c échouée

EXEMPLES
  depman -s projet-light
  depman -f projet-medium
  depman -t projet-heavy
  sudo depman -r projet-medium                  # dernier snapshot
  sudo depman -r projet-medium 20260504120000   # snapshot spécifique
  depman --diff python-test 20260511171214 20260511164240  # comparer deux snapshots

FORMAT deps.conf
  # commentaire
  [project:monapp]
  git >= 2.30
  curl >= 7.0
  nodejs >= 16.0

EOF
}

# ---------------------------------------------------------------------------
# Comparaison de versions (Bash pur)
# version_cmp <installed> <operator> <required>
# Retourne 0 si la contrainte est satisfaite, 1 sinon
# Opérateurs supportés : >= > == = <=
# ---------------------------------------------------------------------------
_ver_compare() {
    local installed="$1"
    local required="$2"
    # Retourne : -1 si installed < required, 0 si égal, 1 si installed > required

    IFS='.' read -ra inst_parts <<< "$installed"
    IFS='.' read -ra req_parts  <<< "$required"

    local max_len="${#inst_parts[@]}"
    (( ${#req_parts[@]} > max_len )) && max_len="${#req_parts[@]}"

    for (( i=0; i<max_len; i++ )); do
        local a="${inst_parts[$i]:-0}"
        local b="${req_parts[$i]:-0}"
        a="${a//[^0-9]/}"; a="${a:-0}"
        b="${b//[^0-9]/}"; b="${b:-0}"
        if (( 10#$a > 10#$b )); then echo  1; return; fi
        if (( 10#$a < 10#$b )); then echo -1; return; fi
    done
    echo 0   # égaux
}

version_satisfies() {
    local installed="$1"
    local op="$2"
    local required="$3"
    local cmp
    cmp=$(_ver_compare "$installed" "$required")
    case "$op" in
        ">=" ) [[ "$cmp" -ge 0 ]] ;;
        ">"  ) [[ "$cmp" -gt 0 ]] ;;
        "=="|"=") [[ "$cmp" -eq 0 ]] ;;
        "<=") [[ "$cmp" -le 0 ]] ;;
        "<" ) [[ "$cmp" -lt 0 ]] ;;
        *   ) return 0 ;; # opérateur inconnu → toujours OK
    esac
}

# Compat alias (used elsewhere)
version_ge() { version_satisfies "$1" ">=" "$2"; }

# ---------------------------------------------------------------------------
# Vérification et installation d'un paquet (distro-agnostique)
# ---------------------------------------------------------------------------
check_dep() {
    local pkg="$1"
    local req_op="$2"
    local req_ver="$3"
    local inst_ver=""
    local installed=false

    case "$PM" in
        apt)
            if dpkg -l "$pkg" 2>/dev/null | grep -q '^ii'; then
                installed=true
                inst_ver=$(dpkg -l "$pkg" 2>/dev/null | awk '/^ii/{print $3}' | head -1)
                inst_ver="${inst_ver##*:}"; inst_ver="${inst_ver%%-*}"
            fi
            ;;
        pacman)
            if pacman -Q "$pkg" &>/dev/null; then
                installed=true
                inst_ver=$(pacman -Q "$pkg" 2>/dev/null | awk '{print $2}')
                inst_ver="${inst_ver%%-*}"
            fi
            ;;
        dnf|yum)
            if rpm -q "$pkg" &>/dev/null; then
                installed=true
                inst_ver=$(rpm -q --qf '%{VERSION}' "$pkg" 2>/dev/null)
            fi
            ;;
        zypper)
            if rpm -q "$pkg" &>/dev/null; then
                installed=true
                inst_ver=$(rpm -q --qf '%{VERSION}' "$pkg" 2>/dev/null)
            fi
            ;;
        apk)
            if apk info -e "$pkg" &>/dev/null; then
                installed=true
                inst_ver=$(apk info "$pkg" 2>/dev/null | head -1 | grep -oE '[0-9]+\.[0-9]+[.0-9]*')
            fi
            ;;
        *)
            log_error "Gestionnaire de paquets non supporté : $PM"
            return 1
            ;;
    esac

    if $installed; then
        if version_satisfies "$inst_ver" "$req_op" "$req_ver"; then
            log_info "${C_GREEN}✔${C_RESET} $pkg $req_op $req_ver ${C_DIM}(v${inst_ver})${C_RESET}"
        else
            log_info "${C_YELLOW}⚠${C_RESET} $pkg v${inst_ver} ne satisfait pas $req_op $req_ver — mise à jour..."
            install_dep "$pkg"
        fi
    else
        log_info "${C_YELLOW}↓${C_RESET} $pkg absent — installation en cours..."
        install_dep "$pkg"
    fi
}

install_dep() {
    local pkg="$1"
    local new_ver=""

    # Mode simulation : afficher uniquement, ne rien installer
    if (( DRY_RUN )); then
        log_info "${C_MAGENTA}${C_BOLD}[DRY-RUN]${C_RESET} ${C_MAGENTA}$pkg${C_RESET} serait installé"
        return 0
    fi

    case "$PM" in
        apt)
            if ! apt-cache show "$pkg" &>/dev/null; then
                log_error "$pkg introuvable dans les dépôts apt [code 103]"
                return 103
            fi
            apt-get install -y "$pkg" &>/dev/null \
                || { log_error "$pkg : échec de l'installation [code 103]"; return 103; }
            new_ver=$(dpkg -l "$pkg" 2>/dev/null | awk '/^ii/{print $3}' | head -1)
            new_ver="${new_ver##*:}"; new_ver="${new_ver%%-*}"
            ;;
        pacman)
            if ! pacman -Si "$pkg" &>/dev/null; then
                log_error "$pkg introuvable dans les dépôts pacman [code 103]"
                return 103
            fi
            pacman -S --noconfirm "$pkg" &>/dev/null \
                || { log_error "$pkg : échec de l'installation [code 103]"; return 103; }
            new_ver=$(pacman -Q "$pkg" 2>/dev/null | awk '{print $2}')
            new_ver="${new_ver%%-*}"
            ;;
        dnf)
            if ! dnf info "$pkg" &>/dev/null; then
                log_error "$pkg introuvable dans les dépôts dnf [code 103]"
                return 103
            fi
            dnf install -y "$pkg" &>/dev/null \
                || { log_error "$pkg : échec de l'installation [code 103]"; return 103; }
            new_ver=$(rpm -q --qf '%{VERSION}' "$pkg" 2>/dev/null)
            ;;
        yum)
            if ! yum info "$pkg" &>/dev/null; then
                log_error "$pkg introuvable dans les dépôts yum [code 103]"
                return 103
            fi
            yum install -y "$pkg" &>/dev/null \
                || { log_error "$pkg : échec de l'installation [code 103]"; return 103; }
            new_ver=$(rpm -q --qf '%{VERSION}' "$pkg" 2>/dev/null)
            ;;
        zypper)
            if ! zypper info "$pkg" &>/dev/null; then
                log_error "$pkg introuvable dans les dépôts zypper [code 103]"
                return 103
            fi
            zypper install -y "$pkg" &>/dev/null \
                || { log_error "$pkg : échec de l'installation [code 103]"; return 103; }
            new_ver=$(rpm -q --qf '%{VERSION}' "$pkg" 2>/dev/null)
            ;;
        apk)
            if ! apk search -e "$pkg" &>/dev/null; then
                log_error "$pkg introuvable dans les dépôts apk [code 103]"
                return 103
            fi
            apk add "$pkg" &>/dev/null \
                || { log_error "$pkg : échec de l'installation [code 103]"; return 103; }
            new_ver=$(apk info "$pkg" 2>/dev/null | head -1 | grep -oE '[0-9]+\.[0-9]+[.0-9]*')
            ;;
        *)
            log_error "Gestionnaire de paquets non supporté : $PM [code 103]"
            return 103
            ;;
    esac

    log_info "${C_GREEN}✔ $pkg installé avec succès${C_RESET} ${C_DIM}(v${new_ver:-?})${C_RESET}"
}

# ---------------------------------------------------------------------------
# Parsing de deps.conf
# ---------------------------------------------------------------------------
parse_conf() {
    local project="$1"
    local conf_file="$project/deps.conf"

    # Erreur 102 si fichier absent
    [[ ! -f "$conf_file" ]] && handle_error 102 "deps.conf introuvable dans '$project'"

    # Lire les dépendances (ignorer commentaires, sections, lignes vides)
    while IFS= read -r line; do
        # Ignorer commentaires et sections
        [[ "$line" =~ ^[[:space:]]*# ]] && continue
        [[ "$line" =~ ^[[:space:]]*\[ ]] && continue
        [[ -z "${line// }" ]] && continue

        # Parser : paquet [>=|>|==|=|<=] version
        if [[ "$line" =~ ^([a-zA-Z0-9_+.-]+)[[:space:]]*(>=|>|==|=|<=|<)[[:space:]]*([0-9][0-9.]*)$ ]]; then
            local pkg="${BASH_REMATCH[1]}"
            local op="${BASH_REMATCH[2]}"
            local ver="${BASH_REMATCH[3]}"
            echo "$pkg $op $ver"
        fi
    done < "$conf_file"
}

# ---------------------------------------------------------------------------
# Snapshot (distro-agnostique)
# ---------------------------------------------------------------------------
snapshot() {
    local project="$1"
    mkdir -p "$SNAPSHOT_DIR"
    local proj_slug="${project%/}"; proj_slug="${proj_slug//\//_}"
    local snap_file="$SNAPSHOT_DIR/${proj_slug}_$(date +%Y%m%d%H%M%S).snap"

    case "$PM" in
        apt)    dpkg --get-selections > "$snap_file" ;;
        pacman) pacman -Qqe            > "$snap_file" ;;
        dnf|yum|zypper) rpm -qa --qf '%{NAME}\n' > "$snap_file" ;;
        apk)    apk info               > "$snap_file" ;;
        *)
            log_error "Snapshot non supporté pour le gestionnaire : $PM"
            return 1
            ;;
    esac

    log_info "Snapshot sauvegardé : $snap_file"
    echo "$snap_file"
}

restore_snapshot() {
    local project="$1"
    local snap_ts="${2:-}"   # horodatage optionnel (ex: 20260504120000)
    local proj_slug="${project%/}"; proj_slug="${proj_slug//\//_}"
    local pattern="$SNAPSHOT_DIR/${proj_slug}_*.snap"
    local snap_file

    if [[ -n "$snap_ts" ]]; then
        # Snapshot spécifique demandé
        snap_file="$SNAPSHOT_DIR/${proj_slug}_${snap_ts}.snap"
        if [[ ! -f "$snap_file" ]]; then
            log_error "Snapshot '$snap_ts' introuvable pour '$project'."
            log_error "Snapshots disponibles :"
            # shellcheck disable=SC2086
            ls -1t $pattern 2>/dev/null \
                | sed "s|$SNAPSHOT_DIR/||" \
                | sed "s|${proj_slug}_||;s|\.snap||" \
                || log_error "  (aucun snapshot trouvé)"
            handle_error 105 "Snapshot introuvable : $snap_ts"
        fi
    else
        # Dernier snapshot (comportement par défaut)
        # shellcheck disable=SC2086
        snap_file=$(ls -t $pattern 2>/dev/null | head -1)
        [[ -z "$snap_file" ]] && handle_error 105 "Aucun snapshot trouvé pour '$project'"
    fi

    log_info "Restauration depuis $snap_file ..."
    case "$PM" in
        apt)
            dpkg --set-selections < "$snap_file"
            apt-get dselect-upgrade -y
            ;;
        pacman)
            # shellcheck disable=SC2046
            pacman -S --noconfirm $(cat "$snap_file") &>/dev/null
            ;;
        dnf|yum|zypper|apk)
            log_error "Restauration automatique non supportée pour $PM — snapshot conservé à titre informatif."
            ;;
        *)
            handle_error 105 "Restauration non supportée pour : $PM"
            ;;
    esac
    log_info "Restauration terminée."
}

# ---------------------------------------------------------------------------
# Comparaison de deux snapshots (-d | --diff)
# ---------------------------------------------------------------------------
diff_snapshots() {
    local project="$1"
    local ts1="$2"
    local ts2="$3"
    local proj_slug="${project%/}"; proj_slug="${proj_slug//\//_}"
    local snap1="$SNAPSHOT_DIR/${proj_slug}_${ts1}.snap"
    local snap2="$SNAPSHOT_DIR/${proj_slug}_${ts2}.snap"

    [[ ! -f "$snap1" ]] && handle_error 105 "Snapshot '$ts1' introuvable pour '$project'"
    [[ ! -f "$snap2" ]] && handle_error 105 "Snapshot '$ts2' introuvable pour '$project'"

    # Extraire uniquement le nom du paquet (1er champ) — compatible apt & pacman
    local tmp1 tmp2
    tmp1=$(awk '{print $1}' "$snap1" | sort)
    tmp2=$(awk '{print $1}' "$snap2" | sort)

    local added removed
    added=$(comm   -13 <(echo "$tmp1") <(echo "$tmp2") | grep -v '^[[:space:]]*$' || true)
    removed=$(comm -23 <(echo "$tmp1") <(echo "$tmp2") | grep -v '^[[:space:]]*$' || true)

    local n_added=0 n_removed=0
    [[ -n "$added" ]]   && n_added=$(echo "$added"   | wc -l)
    [[ -n "$removed" ]] && n_removed=$(echo "$removed" | wc -l)

    echo ""
    echo "${C_BOLD}${C_BLUE}═══ Diff snapshot : $project ═══${C_RESET}"
    echo "${C_DIM}  [A] $ts1  →  $(basename "$snap1")${C_RESET}"
    echo "${C_DIM}  [B] $ts2  →  $(basename "$snap2")${C_RESET}"
    echo ""

    if [[ -n "$added" ]]; then
        echo "${C_BOLD}${C_GREEN}+ Paquets présents dans [B] mais absents de [A] :${C_RESET}"
        while IFS= read -r pkg; do
            echo "  ${C_GREEN}+${C_RESET} $pkg"
        done <<< "$added"
        echo ""
    fi

    if [[ -n "$removed" ]]; then
        echo "${C_BOLD}${C_RED}− Paquets présents dans [A] mais absents de [B] :${C_RESET}"
        while IFS= read -r pkg; do
            echo "  ${C_RED}−${C_RESET} $pkg"
        done <<< "$removed"
        echo ""
    fi

    if [[ -z "$added" && -z "$removed" ]]; then
        echo "${C_GREEN}${C_BOLD}✔ Les deux snapshots sont identiques.${C_RESET}"
    else
        echo "${C_DIM}Résumé : ${C_GREEN}+${n_added} ajouté(s)${C_RESET}${C_DIM}, ${C_RED}−${n_removed} supprimé(s)${C_RESET}"
    fi
    echo ""
}

# ---------------------------------------------------------------------------
# Compilation du programme C
# ---------------------------------------------------------------------------
compile_thread_prog() {
    # Ne recompiler que si binaire absent ou source plus récente
    if [[ -f "$THREAD_BIN" && "$THREAD_BIN" -nt "$THREAD_SRC" ]]; then
        return 0
    fi
    [[ ! -f "$THREAD_SRC" ]] && handle_error 106 "depman_thread.c introuvable"
    gcc -o "$THREAD_BIN" "$THREAD_SRC" -lpthread \
        || handle_error 106 "Compilation de depman_thread.c échouée"
    log_info "Programme thread compilé avec succès"
}

# ---------------------------------------------------------------------------
# Mode SUBSHELL (-s)  — séquentiel dans un sous-shell (isolation variables)
# ---------------------------------------------------------------------------
run_subshell() {
    local project="$1"
    log_info "${C_BOLD}${C_BLUE}═══ Mode subshell — '$project' ═══${C_RESET}"
    local code=0
    (
        while IFS=' ' read -r pkg op ver; do
            check_dep "$pkg" "$op" "$ver"
        done < <(parse_conf "$project")
    ) || code=$?
    if (( DRY_RUN )); then
        log_info "${C_MAGENTA}${C_BOLD}[DRY-RUN]${C_RESET} ${C_MAGENTA}Snapshot ignoré (simulation)${C_RESET}"
    else
        snapshot "$project"
    fi
    return $code
}

# ---------------------------------------------------------------------------
# Mode FORK (-f)  — un processus fils par paquet
# ---------------------------------------------------------------------------
run_fork() {
    local project="$1"
    log_info "${C_BOLD}${C_BLUE}═══ Mode fork — '$project' ═══${C_RESET}"

    local pids=()
    while IFS=' ' read -r pkg op ver; do
        (
            check_dep "$pkg" "$op" "$ver"
        ) &
        pids+=($!)
        log_info "${C_CYAN}⇢${C_RESET} Processus fils lancé pour ${C_BOLD}$pkg${C_RESET} (PID $!)"
    done < <(parse_conf "$project")

    # Attendre tous les fils
    local exit_code=0
    for pid in "${pids[@]}"; do
        wait "$pid" || exit_code=$?
    done

    if (( DRY_RUN )); then
        log_info "${C_MAGENTA}${C_BOLD}[DRY-RUN]${C_RESET} ${C_MAGENTA}Snapshot ignoré (simulation)${C_RESET}"
    else
        snapshot "$project"
    fi
    return $exit_code
}

# ---------------------------------------------------------------------------
# Mode THREAD (-t)  — dépendances vérifiées via depman_thread (C+pthreads)
# ---------------------------------------------------------------------------
run_thread() {
    local project="$1"
    log_info "${C_BOLD}${C_BLUE}═══ Mode thread — '$project' ═══${C_RESET}"

    compile_thread_prog

    # Collecter la liste des paquets
    local pkgs=()
    local ops=()
    local vers=()
    while IFS=' ' read -r pkg op ver; do
        pkgs+=("$pkg")
        ops+=("$op")
        vers+=("$ver")
    done < <(parse_conf "$project")

    [[ ${#pkgs[@]} -eq 0 ]] && handle_error 102 "Aucune dépendance dans deps.conf"

    # Appel du programme C (vérifie la présence du paquet en parallèle)
    local results
    results=$("$THREAD_BIN" "$PM" "${pkgs[@]}")

    # Traiter les résultats (format: nom_paquet:1 ou nom_paquet:0)
    # Le programme C ne vérifie que la présence ; on délègue la vérification
    # de version à check_dep pour les paquets présents ET absents.
    local idx=0
    while IFS=: read -r pkg status; do
        local op="${ops[$idx]:->=}"
        local ver="${vers[$idx]:-0}"
        (( idx++ )) || true
        if [[ "$status" -eq 1 ]]; then
            # Paquet présent : vérifier la contrainte de version
            check_dep "$pkg" "$op" "$ver"
        else
            log_info "${C_YELLOW}↓${C_RESET} $pkg : absent — installation en cours..."
            install_dep "$pkg"
        fi
    done <<< "$results"

    if (( DRY_RUN )); then
        log_info "${C_MAGENTA}${C_BOLD}[DRY-RUN]${C_RESET} ${C_MAGENTA}Snapshot ignoré (simulation)${C_RESET}"
    else
        snapshot "$project"
    fi
}

# ---------------------------------------------------------------------------
# Mode RESTAURATION (-r)  — root requis
# ---------------------------------------------------------------------------
run_restore() {
    local project="$1"
    local snap_ts="${2:-}"
    [[ $EUID -ne 0 ]] && handle_error 104 "L'option -r nécessite les privilèges root"
    restore_snapshot "$project" "$snap_ts"
}

# ---------------------------------------------------------------------------
# Point d'entrée principal
# ---------------------------------------------------------------------------
main() {
    [[ $# -eq 0 ]] && { log_error "[Erreur 101] Aucune option fournie. Utilisez 'depman -h' pour afficher l'aide."; exit 101; }

    local opt_s=0 opt_f=0 opt_t=0 opt_r=0 opt_l=0 opt_n=0 opt_d=0
    local project="" alt_log="" snap_ts="" snap_ts2=""

    # Parsing des options avec getopt
    local OPTS
    OPTS=$(getopt -o sftl:rndhv --long help,dry-run,diff,version -n "depman" -- "$@") \
        || handle_error 100 "Option inexistante"
    eval set -- "$OPTS"

    while true; do
        case "$1" in
            -s) opt_s=1; shift ;;
            -f) opt_f=1; shift ;;
            -t) opt_t=1; shift ;;
            -r) opt_r=1; shift ;;
            -d|--diff) opt_d=1; shift ;;
            -l) opt_l=1; alt_log="$2"
                LOG_DIR="${alt_log%/}"
                LOG_FILE="$LOG_DIR/history.log"
                SNAPSHOT_DIR="$LOG_DIR/snapshots"
                shift 2 ;;
            -n|--dry-run) opt_n=1; DRY_RUN=1; shift ;;
            -v|--version) echo "depman v1.0.0"; exit 0 ;;
            -h|--help) show_help; exit 0 ;;
            --) shift; break ;;
            *) handle_error 100 "Option inexistante" ;;
        esac
    done

    if (( opt_s + opt_f + opt_t + opt_r + opt_d > 1 )); then
        handle_error 100 "Option inexistante"
    fi

    project="${1:-}"
    snap_ts="${2:-}"
    snap_ts2="${3:-}"

    # Vérifier qu'un projet est fourni si une action est demandée
    if (( opt_s || opt_f || opt_t || opt_r || opt_d )); then
        [[ -z "$project" ]] && handle_error 101 "Paramètre <projet> manquant"
        if (( opt_d )); then
            [[ -z "$snap_ts" || -z "$snap_ts2" ]] \
                && handle_error 101 "--diff requiert deux horodatages : depman --diff <projet> <ts1> <ts2>"
        fi
    else
        handle_error 101 "Aucune option d'action fournie"
    fi

    # Créer le répertoire de log
    mkdir -p "$LOG_DIR" 2>/dev/null || true

    # Détecter le gestionnaire de paquets
    PM=$(detect_pm)
    log_info "${C_CYAN}⚙${C_RESET} Gestionnaire de paquets détecté : ${C_BOLD}$PM${C_RESET}"
    [[ "$PM" == "unknown" ]] && handle_error 100 "Aucun gestionnaire de paquets supporté trouvé (apt/pacman/dnf/yum/zypper/apk)"

    # Dispatcher
    if   (( opt_r )); then run_restore    "$project" "$snap_ts"
    elif (( opt_d )); then diff_snapshots "$project" "$snap_ts" "$snap_ts2"
    elif (( opt_s )); then run_subshell   "$project"
    elif (( opt_f )); then run_fork       "$project"
    elif (( opt_t )); then run_thread     "$project"
    fi
}

main "$@"
