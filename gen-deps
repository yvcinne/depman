#!/usr/bin/env bash
# =============================================================================
# gen-deps — Génère automatiquement un fichier deps.conf
#            à partir des paquets installés sur le système.
#
# Usage : gen-deps [<projet>] [paquet1 paquet2 ...]
#
# Exemples :
#   gen-deps                         → génère deps.conf dans le répertoire courant
#   gen-deps mon-projet              → génère mon-projet/deps.conf
#   gen-deps mon-projet git curl gcc → seulement ces paquets
# =============================================================================

set -euo pipefail

# ---------------------------------------------------------------------------
# Aide
# ---------------------------------------------------------------------------
show_help() {
    cat <<'EOF'

USAGE
  gen-deps [<projet>] [-r <fichier>] [paquet1 paquet2 ...]

ARGUMENTS
  <projet>              Répertoire cible où deps.conf sera créé.
                        Si omis, génère ./deps.conf dans le dossier courant.
  paquet1 paquet2 ...   Paquets à inclure. Si omis, utilise la liste par défaut.

OPTIONS
  -r, --requirements <fichier>   Lit les paquets depuis un fichier (style requirements.txt)
  -h, --help                     Affiche cette aide

EXEMPLES
  gen-deps                                      # deps.conf dans le dossier courant
  gen-deps mon-projet                           # mon-projet/deps.conf, paquets par défaut
  gen-deps mon-projet git curl gcc              # paquets explicites
  gen-deps . git curl python openssl            # dossier courant, paquets explicites
  gen-deps mon-projet -r requirements.txt       # depuis un fichier requirements.txt

PAQUETS PAR DÉFAUT
  git  curl  wget  python/python3  gcc  make  cmake
  tar  unzip  rsync  openssl  bash

FORMAT GÉNÉRÉ
  [project:<nom>]
  git                  >= 2.54.0
  curl                 >= 8.20.0
  # nodejs  (non installé — version minimale à définir manuellement)

EOF
}

# ---------------------------------------------------------------------------
# Détection du gestionnaire de paquets
# ---------------------------------------------------------------------------
detect_pm() {
    if   command -v apt-get &>/dev/null; then echo "apt"
    elif command -v pacman  &>/dev/null; then echo "pacman"
    elif command -v dnf     &>/dev/null; then echo "dnf"
    elif command -v yum     &>/dev/null; then echo "yum"
    elif command -v zypper  &>/dev/null; then echo "zypper"
    elif command -v apk     &>/dev/null; then echo "apk"
    else echo "unknown"
    fi
}

PM=$(detect_pm)

# ---------------------------------------------------------------------------
# Gestion de l'aide
# ---------------------------------------------------------------------------
for _arg in "$@"; do
    if [[ "$_arg" == "-h" || "$_arg" == "--help" ]]; then
        show_help
        exit 0
    fi
done

# ---------------------------------------------------------------------------
# Nom du paquet Python selon le gestionnaire de paquets
# (Arch utilise 'python', les autres utilisent 'python3')
# ---------------------------------------------------------------------------
case "$PM" in
    pacman) PYTHON_PKG="python" ;;
    *)      PYTHON_PKG="python3" ;;
esac

# ---------------------------------------------------------------------------
# Récupère la version installée d'un paquet selon le gestionnaire de paquets
# ---------------------------------------------------------------------------
get_version() {
    local pkg="$1"
    local ver=""

    case "$PM" in
        apt)
            ver=$(dpkg -l "$pkg" 2>/dev/null | awk '/^ii/{print $3}' | head -1)
            ver="${ver##*:}"; ver="${ver%%-*}"
            ;;
        pacman)
            ver=$(pacman -Q "$pkg" 2>/dev/null | awk '{print $2}')
            ver="${ver%%-*}"
            ;;
        dnf|yum|zypper)
            ver=$(rpm -q --qf '%{VERSION}' "$pkg" 2>/dev/null)
            ;;
        apk)
            ver=$(apk info "$pkg" 2>/dev/null | head -1 | grep -oE '[0-9]+\.[0-9]+[.0-9]*')
            ;;
    esac

    echo "$ver"
}

# ---------------------------------------------------------------------------
# Lecture d'un fichier requirements.txt
# Extrait les noms des paquets et préserve les versions (==, >=, <=, etc.)
# ---------------------------------------------------------------------------
read_requirements() {
    local file="$1"
    if [[ ! -f "$file" ]]; then
        echo "gen-deps: fichier requirements '${file}' introuvable" >&2
        exit 1
    fi
    while IFS= read -r line; do
        # Ignorer commentaires et lignes vides
        [[ "$line" =~ ^[[:space:]]*# ]] && continue
        [[ -z "${line//[[:space:]]/}" ]]  && continue
        # Ignorer les directives pip (-r, -i, --index-url, etc.)
        [[ "$line" =~ ^[[:space:]]*- ]]   && continue
        
        # Supprimer les extras [extra] et les espaces
        local req
        req=$(printf '%s' "$line" | sed 's/\[[^]]*\]//g' | tr -d '[:space:]')
        
        [[ -n "$req" ]] && echo "$req"
    done < "$file"
}

# ---------------------------------------------------------------------------
# Paquets par défaut si aucun n'est fourni
# ---------------------------------------------------------------------------
DEFAULT_PACKAGES=(
    git curl wget "$PYTHON_PKG" gcc make cmake
    tar unzip rsync openssl bash
)

# ---------------------------------------------------------------------------
# Parsing des arguments
# ---------------------------------------------------------------------------
PROJECT=""
PACKAGES=()
REQ_FILE=""

# Pré-scan : extraire -r/--requirements (peut apparaître n'importe où)
_filtered_args=()
_i=1
while [[ $_i -le $# ]]; do
    _cur="${!_i}"
    if [[ "$_cur" == "-r" || "$_cur" == "--requirements" ]]; then
        (( _i++ ))
        [[ $_i -gt $# ]] && { echo "gen-deps: option '$_cur' attend un fichier" >&2; exit 1; }
        REQ_FILE="${!_i}"
    else
        _filtered_args+=("$_cur")
    fi
    (( _i++ ))
done
set -- "${_filtered_args[@]+"${_filtered_args[@]}"}"   # réinjecter sans -r

if [[ $# -ge 1 && ! "$1" =~ ^- ]]; then
    PROJECT="$1"
    shift
fi

if [[ -n "$REQ_FILE" ]]; then
    mapfile -t PACKAGES < <(read_requirements "$REQ_FILE")
    [[ ${#PACKAGES[@]} -eq 0 ]] && { echo "gen-deps: aucun paquet trouvé dans '$REQ_FILE'" >&2; exit 1; }
elif [[ $# -ge 1 ]]; then
    PACKAGES=("$@")
else
    PACKAGES=("${DEFAULT_PACKAGES[@]}")
fi

# ---------------------------------------------------------------------------
# Destination du fichier
# ---------------------------------------------------------------------------
if [[ -n "$PROJECT" ]]; then
    mkdir -p "$PROJECT"
    OUT="$PROJECT/deps.conf"
else
    OUT="deps.conf"
fi

PROJECT_NAME="${PROJECT:-$(basename "$(pwd)")}"

# ---------------------------------------------------------------------------
# Génération
# ---------------------------------------------------------------------------
{
    echo "# Fichier de configuration des dépendances"
    echo "# Généré automatiquement le $(date '+%Y-%m-%d %H:%M:%S') par gen-deps"
    echo "# Format : nom_paquet >= version_minimale"
    echo ""
    echo "[project:$PROJECT_NAME]"

    for item in "${PACKAGES[@]}"; do
        # Vérifier si l'élément contient déjà une contrainte de version (ex: paquet==1.0.0, paquet>=2.0)
        if [[ "$item" =~ ^([^=><~!]+)([=><~!]+)(.*)$ ]]; then
            pkg="${BASH_REMATCH[1]}"
            op="${BASH_REMATCH[2]}"
            ver="${BASH_REMATCH[3]}"
            printf "%-20s %s %s\n" "$pkg" "$op" "$ver"
        else
            pkg="$item"
            ver=$(get_version "$pkg")
            if [[ -n "$ver" ]]; then
                printf "%-20s >= %s\n" "$pkg" "$ver"
            else
                echo "# $pkg  (non installé — version minimale à définir manuellement)"
            fi
        fi
    done
} > "$OUT"

echo "deps.conf généré : $OUT"
cat "$OUT"
