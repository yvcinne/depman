#!/usr/bin/env bash
# =============================================================================
# gen-deps — Génère automatiquement un fichier deps.conf
#            à partir des paquets installés sur le système.
#
# Usage : gen-deps [<projet>] [paquet1 paquet2 ...]
#
# Exemples :
#   gen-deps                         → génère deps.conf dans le répertoire courant
#   gen-deps mon-projet              → génère mon-projet/deps.conf
#   gen-deps mon-projet git curl gcc → seulement ces paquets
# =============================================================================

set -euo pipefail

# ---------------------------------------------------------------------------
# Aide
# ---------------------------------------------------------------------------
show_help() {
    cat <<'EOF'

USAGE
  gen-deps [<projet>] [paquet1 paquet2 ...]
  gen-deps [<projet>] -r <requirements.txt> [paquet1 paquet2 ...]

ARGUMENTS
  <projet>              Répertoire cible où deps.conf sera créé.
                        Si omis, génère ./deps.conf dans le dossier courant.
  paquet1 paquet2 ...   Paquets système à inclure. Si omis et sans -r, utilise la liste par défaut.

OPTIONS
  -r, --requirements <fichier>   Lit les paquets depuis un fichier requirements.txt.
                                 Chaque paquet est résolu en priorité comme paquet système ;
                                 si non trouvé, le préfixe python est essayé automatiquement.
  -h, --help                     Affiche cette aide

EXEMPLES
  gen-deps                                          # deps.conf dans le dossier courant
  gen-deps mon-projet                               # mon-projet/deps.conf, paquets par défaut
  gen-deps mon-projet git curl gcc                  # paquets système explicites
  gen-deps mon-projet -r requirements.txt           # depuis requirements.txt uniquement
  gen-deps mon-projet -r requirements.txt git curl  # requirements.txt + paquets système

PAQUETS PAR DÉFAUT (utilisés si aucun paquet et sans -r)
  git  curl  wget  python/python3  gcc  make  cmake  tar  unzip  rsync  openssl  bash

FORMAT GÉNÉRÉ
  [project:<nom>]
  git                  >= 2.54.0
  python-flask         >= 3.1.0
EOF
}

# ---------------------------------------------------------------------------
# Parsing des options (avant détection du PM)
# ---------------------------------------------------------------------------
REQ_FILE=""
_POSARGS=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) show_help; exit 0 ;;
        -r|--requirements)
            [[ -z "${2:-}" ]] && { echo "gen-deps: -r requiert un fichier" >&2; exit 1; }
            REQ_FILE="$2"; shift 2 ;;
        *) _POSARGS+=("$1"); shift ;;
    esac
done
set -- "${_POSARGS[@]+"${_POSARGS[@]}"}"

# ---------------------------------------------------------------------------
# Détection du gestionnaire de paquets
# ---------------------------------------------------------------------------
detect_pm() {
    if   command -v apt-get &>/dev/null; then echo "apt"
    elif command -v pacman  &>/dev/null; then echo "pacman"
    elif command -v dnf     &>/dev/null; then echo "dnf"
    elif command -v yum     &>/dev/null; then echo "yum"
    elif command -v zypper  &>/dev/null; then echo "zypper"
    elif command -v apk     &>/dev/null; then echo "apk"
    else echo "unknown"
    fi
}

PM=$(detect_pm)

# ---------------------------------------------------------------------------
# Nom du paquet Python selon le gestionnaire de paquets
# (Arch utilise 'python', les autres utilisent 'python3')
# ---------------------------------------------------------------------------
case "$PM" in
    pacman) PYTHON_PKG="python" ;;
    *)      PYTHON_PKG="python3" ;;
esac

# ---------------------------------------------------------------------------
# Récupère la version installée d'un paquet selon le gestionnaire de paquets
# ---------------------------------------------------------------------------
get_version() {
    local pkg="$1"
    local ver=""

    case "$PM" in
        apt)
            ver=$(dpkg -l "$pkg" 2>/dev/null | awk '/^ii/{print $3}' | head -1)
            ver="${ver##*:}"; ver="${ver%%-*}"
            ;;
        pacman)
            ver=$(pacman -Q "$pkg" 2>/dev/null | awk '{print $2}')
            ver="${ver%%-*}"
            ;;
        dnf|yum|zypper)
            ver=$(rpm -q --qf '%{VERSION}' "$pkg" 2>/dev/null)
            ;;
        apk)
            ver=$(apk info "$pkg" 2>/dev/null | head -1 | grep -oE '[0-9]+\.[0-9]+[.0-9]*')
            ;;
    esac

    echo "$ver"
}

# ---------------------------------------------------------------------------
# Résolution Python-aware : système d'abord, puis préfixe python
# ---------------------------------------------------------------------------

# Retourne le préfixe python pour le gestionnaire courant
python_prefix() {
    case "$PM" in
        pacman)             echo "python-"  ;;
        apt|dnf|yum|zypper) echo "python3-" ;;
        apk)                echo "py3-"     ;;
        *)                  echo "python-"  ;;
    esac
}

# Extrait les noms de paquets d'un requirements.txt (sans contraintes de version)
parse_requirements() {
    local file="$1"
    while IFS= read -r line; do
        [[ "$line" =~ ^[[:space:]]*# ]]  && continue   # commentaires
        [[ -z "${line//[[:space:]]/}" ]] && continue   # lignes vides
        [[ "$line" =~ ^[[:space:]]*-  ]] && continue   # options pip (-r, --index-url…)
        # Supprimer contraintes de version, extras [extra], options inline et espaces
        local pkg
        pkg=$(echo "$line" | sed 's/[><=!;\[#].*//' | tr -d ' ' | tr '[:upper:]' '[:lower:]')
        [[ -n "$pkg" ]] && echo "$pkg"
    done < "$file"
}

# Résoudre un nom de paquet : système en priorité, sinon préfixe python
resolve_pkg() {
    local name="$1"
    # 1) Essai direct (paquet système)
    if [[ -n "$(get_version "$name")" ]]; then
        echo "$name"; return
    fi
    # 2) Essai avec préfixe python
    local pyname; pyname="$(python_prefix)${name}"
    if [[ -n "$(get_version "$pyname")" ]]; then
        echo "$pyname"; return
    fi
    # 3) Non trouvé — retourne le nom original (apparaître en commentaire)
    echo "$name"
}

# ---------------------------------------------------------------------------
# Paquets par défaut si aucun n'est fourni
# ---------------------------------------------------------------------------
DEFAULT_PACKAGES=(
    git curl wget "$PYTHON_PKG" gcc make cmake
    tar unzip rsync openssl bash
)

# ---------------------------------------------------------------------------
# Parsing des arguments positionnels
# ---------------------------------------------------------------------------
PROJECT=""
PACKAGES=()

if [[ $# -ge 1 && ! "$1" =~ ^- ]]; then
    PROJECT="$1"
    shift
fi

[[ $# -ge 1 ]] && PACKAGES=("$@")

# Paquets issus du requirements.txt (résolution automatique)
REQ_PACKAGES=()
if [[ -n "$REQ_FILE" ]]; then
    [[ ! -f "$REQ_FILE" ]] && { echo "gen-deps: fichier introuvable : '$REQ_FILE'" >&2; exit 1; }
    while IFS= read -r pkg; do
        REQ_PACKAGES+=("$(resolve_pkg "$pkg")")
    done < <(parse_requirements "$REQ_FILE")
fi

# Construire la liste finale
if [[ ${#PACKAGES[@]} -eq 0 && ${#REQ_PACKAGES[@]} -eq 0 ]]; then
    PACKAGES=("${DEFAULT_PACKAGES[@]}")
else
    PACKAGES=(
        "${PACKAGES[@]+"${PACKAGES[@]}"}"
        "${REQ_PACKAGES[@]+"${REQ_PACKAGES[@]}"}"
    )
fi

# ---------------------------------------------------------------------------
# Destination du fichier
# ---------------------------------------------------------------------------
if [[ -n "$PROJECT" ]]; then
    mkdir -p "$PROJECT"
    OUT="$PROJECT/deps.conf"
else
    OUT="deps.conf"
fi

PROJECT_NAME="${PROJECT:-$(basename "$(pwd)")}"

# ---------------------------------------------------------------------------
# Génération
# ---------------------------------------------------------------------------
{
    echo "# Fichier de configuration des dépendances"
    echo "# Généré automatiquement le $(date '+%Y-%m-%d %H:%M:%S') par gen-deps"
    echo "# Format : nom_paquet >= version_minimale"
    echo ""
    echo "[project:$PROJECT_NAME]"

    for pkg in "${PACKAGES[@]}"; do
        ver=$(get_version "$pkg")
        if [[ -n "$ver" ]]; then
            printf "%-20s >= %s\n" "$pkg" "$ver"
        else
            echo "# $pkg  (non installé — version minimale à définir manuellement)"
        fi
    done
} > "$OUT"

echo "deps.conf généré : $OUT"
cat "$OUT"
